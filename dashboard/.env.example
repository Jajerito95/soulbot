# Mismo bot de Discord — necesitas el Client ID/Secret de OAuth2 (Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://tu-dashboard.onrender.com/callback

# El mismo token del bot (para leer miembros, banear, etc. vía API REST de Discord)
DISCORD_TOKEN=

# ID de tu servidor (el mismo que usas en GUILD_ID del bot)
GUILD_ID=

# Contraseña de acceso al panel de Staff (tras el login de Discord)
STAFF_PASSWORD=ReyChroxito

# Misma base de datos Turso que usa el bot
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Clave secreta de Flask para las sesiones (genera una aleatoria)
DASHBOARD_SECRET_KEY=cambia-esto-por-algo-aleatorio-largo

# URL pública del BOT (no del dashboard) para poder enlazar a los transcripts de tickets
BOT_PUBLIC_URL=https://tu-bot.onrender.com

PORT=5000
