DISCORD_TOKEN=tu_token_aqui
DB_PATH=soulbot.db
PORT=8080

# Opcional: ID de tu servidor de pruebas para sincronizar los comandos slash al instante
GUILD_ID=

# Turso (base de datos persistente en la nube) - si defines estas dos, se usa
# en vez de SQLite local. Necesario en Render Free (no persiste disco).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL pública del servicio en Render, para los links de transcript de tickets
PUBLIC_URL=

# Contraseña de confirmación para /levels resetserver
RESET_PASSWORD=Chroma

# RCON (Minecraft) — usa Tailscale en producción
# 1) Instala Tailscale en el host del MC y en el host del bot (o usa Headscale)
# 2) RCON_HOST debe ser la IP 100.x.x.x del host MC en tu tailnet, no bore.pub
# 3) Deja RCON_ALLOW_PUBLIC=0; solo pon 1 para pruebas con bore.pub
RCON_HOST=100.64.0.1
RCON_PORT=25575
RCON_PASS=cambia_esta_pass_larga_y_segura
RCON_ALLOW_PUBLIC=0
POSTGRES_URL=postgresql://user:pass@host/db
# Tailscale: https://tailscale.com/download — une ambos hosts a la misma tailnet y abre el firewall 25575 solo para la tailnet
