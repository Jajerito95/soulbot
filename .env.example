DISCORD_TOKEN=tu_token_aqui
DB_PATH=soulbot.db
PORT=8080

# Opcional: ID de tu servidor de pruebas para sincronizar los comandos slash al instante
GUILD_ID=

# Turso (base de datos persistente en la nube) - si defines estas dos, se usa
# en vez de SQLite local. Necesario en Render Free (no persiste disco).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL pública del servicio en Render, para los links de transcript de tickets
PUBLIC_URL=

# Contraseña de confirmación para /levels resetserver
RESET_PASSWORD=Chroma
